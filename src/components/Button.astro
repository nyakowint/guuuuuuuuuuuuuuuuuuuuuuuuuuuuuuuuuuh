---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  appearance?: "neutral" | "accent" | "stealth";
}

const { appearance = "neutral", class: className, type = "button", ...attrs } = Astro.props;
---

<button type={type} class:list={["btn", appearance, className]} {...attrs}><slot /></button>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-width: 32px;
    height: 32px;
    padding: 0 0.75rem;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    border-radius: 4px;
    border: 1px solid var(--border);
    color: var(--fg);
    background: var(--surface);
    cursor: pointer;
    transition: background 0.1s;
  }

  .btn:has(> svg:only-child) {
    padding: 0 0.375rem;
  }

  .btn:hover {
    background: var(--fill-hover);
  }

  .btn:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 1px;
  }

  .accent {
    border-color: transparent;
    color: var(--accent-fg);
    background: var(--accent);
  }

  .accent:hover {
    background: var(--accent-hover);
  }

  .stealth {
    border-color: transparent;
    background: transparent;
  }
</style>
